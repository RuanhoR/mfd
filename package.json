{
  "name": "@mbler/mfd",
  "version": "0.0.1-alpha.3",
  "description": "Minecraft addon downloader website & cli (mfd)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RuanhoR/addon-downloader-website.git"
  },
  "keywords": [
    "Minecraft",
    "addon",
    "downloader",
    "cli"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.10.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./style": {
      "types": "./dist/style-types.d.mts",
      "import": "./dist/style-types.mjs"
    }
  },
  "scripts": {
    "build:frontend": "pnpm -C frontend build",
    "build:cli": "rolldown -c",
    "build": "pnpm build:frontend && pnpm build:cli",
    "dev:frontend": "pnpm -C frontend dev",
    "cli": "node bin/mfd.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "lint:type-check": "tsc --noEmit",
    "check": "pnpm lint && pnpm test && pnpm lint:type-check && pnpm -C frontend type-check",
    "format": "prettier ./src --write"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/server-renderer": "^3.5.13",
    "cac": "^6.7.14",
    "fflate": "^0.8.2",
    "marked": "^16.0.0",
    "rolldown": "^1.2.0",
    "vite": "^8.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mbler/mfd": "workspace:*",
    "@types/node": "^25.0.9",
    "eslint": "10.4.0",
    "globals": "17.0.0",
    "prettier": "3.8.3",
    "rolldown-plugin-dts": "^0.25.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "dist",
    "bin",
    "frontend",
    "!frontend/dist",
    "!frontend/node_modules",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bin": {
    "mfd": "bin/mfd.js"
  }
}
